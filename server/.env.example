PORT=8787
HOST=127.0.0.1
PUBLIC_URL=https://your-domain.example.com

# server = Playwright 서버 크롤링 (배포 기본) | extension = Chrome 확장 브릿지
CRAWL_MODE=extension
PLAYWRIGHT_HEADLESS=false
CRAWL_TIMEOUT_MS=90000

# WordPress REST API
WORDPRESS_URL=https://your-blog.example.com
WORDPRESS_USER=your_username
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
WORDPRESS_POST_STATUS=publish
WORDPRESS_CATEGORY=가전디지털

# 리버스 프록시(Nginx/Caddy) 뒤에 둘 때
TRUST_PROXY=true

# 선택: OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
